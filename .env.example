# Copy to .env.local and fill in. .env.local is git-ignored.

# ─── Airtable (products + inventory + orders) ───
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appm3SLm7J5WuNr9Y
AIRTABLE_PRODUCTS_TBL=Products
AIRTABLE_ORDERS_TBL=Orders

# ─── paygate.to (crypto checkout, non-custodial) ───
# This is your USDC-on-Polygon receive address. Get one by installing
# Trust Wallet on your phone and tapping "Receive → USDC → Polygon".
# Funds settle here directly — paygate.to never holds them.
PAYGATE_MERCHANT_ADDRESS=

# Public URL of THIS Next.js site. paygate.to needs to know where to
# send the IPN (payment notification) and where to redirect the
# customer back to after payment.
#   - Local dev: http://localhost:3000
#   - Production: https://yourdomain.com (NOT localhost — paygate.to
#                 needs to reach the IPN URL from the public internet)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
